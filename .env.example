# Agent-HQ environment variables.
#
# Primary configuration lives in ~/.hq/config.yaml (created by `hq install`).
# Any config key can be set from the environment with the HQ_ prefix and a
# double underscore for nesting, for example HQ_OPENROUTER_API_KEY or
# HQ_RELAY__DISCORD_TOKEN. Never commit real values.

# LLM provider keys (at least one is needed)
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Paths (the systemd unit in deploy/ sets these for servers)
# HQ_VAULT_PATH=/path/to/your/.vault
# HQ_CONFIG_PATH=~/.hq/config.yaml

# Chat relays (optional)
# Optional: sent as HTTP-Referer to LLM endpoints (OpenRouter app attribution).
# HQ_HTTP_REFERER=
# HQ_RELAY__DISCORD_TOKEN=
# HQ_RELAY__TELEGRAM_TOKEN=
# Optional: set your own chat id up front. Otherwise run `hq pair` and send `/pair <code>`.
# HQ_RELAY__TELEGRAM_AUTHORIZED_CHAT_ID=

# web_search works without any key through a built-in engine pool. Optional:
# searxng_url in config.yaml (scripts/setup-searxng.sh) is tried first, and a
# Brave Search API key is the paid last resort.
# HQ_BRAVE_API_KEY=

# Protects /mcp. Required before /mcp accepts any request.
# AGENTHQ_API_KEY=
