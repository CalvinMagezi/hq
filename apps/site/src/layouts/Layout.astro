---
import '../styles/global.css';
import { SITE_URL, latestBuild, links, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  intro?: boolean;
}

const { title, description, path, noindex = false, jsonLd, intro = false } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = `${SITE_URL}/og.png`;
const fullTitle = title.includes('Agent HQ') ? title : `${title} | Agent HQ`;
const current = path;
const GET_PATH = '/get/';
const build = await latestBuild();
// Home is the brand link and Get HQ is the call to action, so the text links are the rest.
const textLinks = nav.filter((n) => n.href !== '/' && n.href !== GET_PATH);

// Scripts and styles are all same-origin files, so no inline hashes are needed.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "media-src 'self'",
  "font-src 'self'",
  "connect-src 'none'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/hq-favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/hq-apple-touch-180.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/ClearSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agent HQ" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agent HQ: an open-source AI assistant that lives on your phone and works with your computers." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Agent HQ: an open-source AI assistant that lives on your phone and works with your computers." />
    {intro && <script is:inline src="/js/intro.js"></script>}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {
      intro && (
        <div class="intro" aria-hidden="true">
          <div class="intro-in">
            <svg class="intro-pair" viewBox="0 0 64 40" aria-hidden="true" focusable="false">
              <circle class="c-blue intro-c1" cx="20" cy="20" r="20" />
              <circle class="c-green intro-c2" cx="44" cy="20" r="20" />
            </svg>
            <p class="intro-word"><span>Agent HQ</span></p>
            <span class="intro-rule"></span>
          </div>
        </div>
      )
    }
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="navshell glass-heavy shine">
        <a class="brand" href="/" aria-current={current === '/' ? 'page' : undefined}><img src="/icons/hq-mark-96.png" alt="" width="32" height="32" /><span>Agent HQ</span></a>
        <nav class="site-nav" aria-label="Main">
          {
            textLinks.map((item) => (
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={links.repo}>GitHub</a>
        </nav>
        <div class="nav-end">
          <details class="menu">
            <summary>Menu</summary>
            <nav class="menu-list glass-heavy" aria-label="Menu">
              {textLinks.map((item) => <a href={item.href}>{item.label}</a>)}
              <a href={links.repo}>GitHub</a>
            </nav>
          </details>
          <a class="btn btn-primary btn-sm nav-cta" href={GET_PATH} aria-current={current === GET_PATH ? 'page' : undefined}>
            Get HQ
          </a>
        </div>
        <span class="progress" aria-hidden="true"></span>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <span class="orb orb-b o-tl" aria-hidden="true"></span>
      <span class="orb orb-g o-br slow" aria-hidden="true"></span>
      <div class="container">
        <div class="pairs" aria-hidden="true">
          {
            ['pair-1', 'pair-2', 'pair-3', 'pair-4'].map((cls) => (
              <svg class={`pair ${cls}`} viewBox="0 0 64 40" aria-hidden="true" focusable="false">
                <circle class="c-blue" cx="20" cy="20" r="20" />
                <circle class="c-green" cx="44" cy="20" r="20" />
              </svg>
            ))
          }
        </div>
        <div class="foot-cta glass">
          <p class="foot-title">Pick your device. Add more later.</p>
          <div class="toc">
            {['Android phone', 'Mac', 'Windows', 'Linux', 'Server'].map((d) => <a href={GET_PATH}>{d}</a>)}
          </div>
          <a class="btn btn-primary" href={GET_PATH}>Get Agent HQ</a>
        </div>
        <p class="body foot-statement">An AI assistant that lives on your phone and works with your computers. Open source under the MIT license.</p>
        <div class="foot-grid">
          <nav class="foot-nav glass" aria-label="Learn">
            <p class="eyebrow">Learn</p>
            <ul class="foot-links">
              {nav.filter((n) => n.href !== '/' && n.href !== '/security/').map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href={links.firstRunDocs}>First run</a></li>
              <li><a href={links.changelog}>Changelog</a></li>
            </ul>
          </nav>
          <nav class="foot-nav glass" aria-label="Trust">
            <p class="eyebrow">Trust</p>
            <ul class="foot-links">
              <li><a href="/security/">Security</a></li>
              <li><a href={links.securityPolicy}>Security policy</a></li>
              <li><a href={links.license}>MIT license</a></li>
              <li><a href={links.releases}>Releases</a></li>
            </ul>
          </nav>
          <nav class="foot-nav glass" aria-label="Stuck">
            <p class="eyebrow">Stuck</p>
            <ul class="foot-links">
              <li class="foot-hint">Run <code>hq doctor</code> first</li>
              <li><a href={links.issues}>Ask on GitHub</a></li>
              <li><a href={links.reportVulnerability}>Report a security problem</a></li>
              <li><a href={links.repo}>Source code</a></li>
            </ul>
          </nav>
        </div>
        <div class="foot-note foot-status">
          <p class="small">
            Build {build.tag}, checked {build.date}. MIT. No cookies, no analytics, nothing loaded from other origins.
            Not affiliated with the projects named on the comparison page.
          </p>
          <a class="small" href="#main">Back to top</a>
        </div>
      </div>
    </footer>
    <p id="copy-status" class="visually-hidden" role="status" aria-live="polite"></p>
    <script is:inline src="/js/enhance.js" defer></script>
  </body>
</html>
