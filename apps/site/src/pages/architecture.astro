---
import Layout from '../layouts/Layout.astro';
import Diagram from '../components/Diagram.astro';
import { links, REPO } from '../data/site';
import {
  processModel,
  crateMap,
  vaultMemory,
  daemon,
  channels,
  mcpGateway,
  agentHost,
  governance,
  releasePipeline,
  topologies,
} from '../data/diagrams';

const toc = [
  ['process', 'Process model'],
  ['crates', 'Crate map'],
  ['vault', 'Vault and memory'],
  ['daemon', 'Daemon'],
  ['relays', 'Chat relays'],
  ['web', 'Web PWA'],
  ['mcp', 'MCP server'],
  ['host', 'Built-in host sessions'],
  ['tasks', 'Tasks'],
  ['governance', 'Governance and sandbox'],
  ['updates', 'Signed updates'],
  ['topologies', 'Deployment'],
  ['source', 'Source map'],
];

const sourceMap = [
  ['CLI binary', 'crates/hq-cli/src/main.rs'],
  ['Agent session', 'crates/hq-agent/src/session/mod.rs'],
  ['Context engine', 'crates/hq-agent/src/context/engine.rs'],
  ['Daemon scheduler', 'crates/hq-cli/src/commands/start/daemon/mod.rs'],
  ['MCP server', 'crates/hq-mcp/src/server.rs'],
  ['The host driver', 'crates/hq-tools/src/agent_host/'],
  ['Harness sessions', 'crates/hq-tools/src/harness_session/'],
  ['Bash sandbox', 'crates/hq-agent/src/bash_sandbox.rs'],
  ['Governance rules', 'crates/hq-agent/src/governance/'],
  ['Updater library', 'crates/hq-update/'],
  ['Web auth and origin guard', 'crates/hq-web/src/auth.rs'],
  ['Native tasks', 'crates/hq-db/src/tasks.rs'],
];

const crateRows = [
  ['Binary', ['hq-cli']],
  ['Host', ['hq-host', 'hq-sandbox']],
  ['Services', ['hq-web', 'hq-relay', 'hq-mcp', 'hq-daemon', 'hq-update']],
  ['Intelligence', ['hq-agent', 'hq-tools', 'hq-memory', 'hq-convert', 'hq-export']],
  ['Foundations', ['hq-core', 'hq-vault', 'hq-db', 'hq-llm']],
] as const;

const MCP_TOOL_DOTS = 100;
const MCP_HITS = [7, 23, 38, 41, 56, 62, 77, 85, 94];
const mcpDots = Array.from({ length: MCP_TOOL_DOTS }, (_, i) => MCP_HITS.indexOf(i));

const updateSteps = [
  'Timer fires every 10 minutes, under a lock',
  'Verify pointer and manifest signatures',
  'Refuse equal, lower or replayed versions',
  'Download with size caps, check SHA-256',
  'Snapshot the vault database',
  "Run the staged binary's --version",
  'Swap by rename, wait for /health',
  'Upgrade, or roll back and alert',
];
---

<Layout
  title="How Agent HQ works: architecture"
  description="How Agent HQ is built: one Rust binary, a markdown and SQLite vault, a daemon, chat relays, a web PWA, an MCP gateway, supervised coding-agent sessions, a bash sandbox and a signed updater."
  path="/architecture/"
>
  <section class="sec sec-hero" aria-labelledby="arch-h">
    <span class="orb orb-b o-tl" aria-hidden="true"></span>
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <span class="orb orb-g o-br slow" aria-hidden="true"></span>
    <div class="container stack">
      <div class="hero-grid">
        <div class="stack">
          <p class="eyebrow">For engineers</p>
          <h1 id="arch-h" class="display">
            <span class="hl"><span>One binary.</span></span>
            <span class="hl"><span>One folder</span></span>
            <span class="hl"><span class="accent">of markdown.</span></span>
          </h1>
          <div class="rule rule-in" aria-hidden="true"></div>
          <p class="lede fade-in hero-lede">
            HQ is one Rust binary around one folder of markdown. This page walks through each part in the
            order you would meet it, with the code paths to read. Everything here comes from the repository documentation. Where a
            document and the code could drift, the page points at the file.
          </p>
        </div>
        <div class="pm-panel glass-heavy shine">
          <div class="pm" role="img" aria-label="One hq binary of about 58 MB takes six roles: terminal chat, the daemon, the Discord and Telegram relays, the web server and the MCP server.">
            <svg class="pm-lines" viewBox="0 0 520 440" aria-hidden="true" focusable="false">
              <path d="M260 220 L260 46"></path>
              <path d="M260 220 L440 122"></path>
              <path d="M260 220 L440 318"></path>
              <path d="M260 220 L260 394"></path>
              <path d="M260 220 L80 318"></path>
              <path d="M260 220 L80 122"></path>
            </svg>
            {[1, 2, 3, 4, 5, 6].map((n) => <span class={`ray ry${n}`}></span>)}
            <span class="hub glass-heavy"><span class="hub-name">hq</span><span class="label">about 58 MB</span></span>
            <span class="role pill glass-light r1">Terminal <code>hq chat</code></span>
            <span class="role pill glass-light r2">Daemon</span>
            <span class="role pill glass-light r3">Discord relay</span>
            <span class="role pill glass-light r4">Telegram relay</span>
            <span class="role pill glass-light r5">Web <code>:5678</code></span>
            <span class="role pill glass-light r6">MCP <code>mcp-serve</code></span>
          </div>
        </div>
      </div>
      <nav aria-label="On this page">
        <ul class="toc">
          {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  <div class="sec sec-top0">
    <span class="orb orb-i o-ml slow" aria-hidden="true"></span>
    <span class="orb orb-b o-mr" aria-hidden="true"></span>
    <span class="orb orb-g orb-y2" aria-hidden="true"></span>
    <span class="orb orb-b orb-y3 slow" aria-hidden="true"></span>
    <span class="orb orb-i orb-y4" aria-hidden="true"></span>
    <span class="orb orb-g orb-y5 slow" aria-hidden="true"></span>
    <div class="container docs">
      <section id="process" class="doc glass-heavy shine reveal" aria-labelledby="process-h">
        <div class="prose">
          <p class="eyebrow">01</p>
          <h2 id="process-h" class="h2-sm">Process model and the single binary</h2>
          <p>
            The <code>hq</code> binary is built from the <code>hq-cli</code> crate. A release build is about
            58 MB with LTO and symbol stripping. The same file runs the terminal chat, the daemon, the
            Discord and Telegram relays, the web server and the MCP server. You pick the role with a
            subcommand.
          </p>
          <p>
            <code>hq start all</code> starts the long-lived components and <code>hq ps</code> lists the
            managed processes. An MCP client does not need any of that: it launches
            <code>hq mcp-serve</code> over stdio itself. <code>hq chat</code> runs the agent in process, so the
            terminal works with nothing else running.
          </p>
          <p>
            Configuration lives in <code>~/.hq/config.yaml</code>, or the file named by
            <code>HQ_CONFIG_PATH</code>. Any key can also come from an <code>HQ_</code> environment variable,
            with <code>__</code> for nesting. The file and its backups are written owner-only.
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz merge" role="img" aria-label="Three configuration sources, the default file, the HQ_CONFIG_PATH override and HQ_ environment variables, merge into one owner-only config.">
            <span class="layer glass-light"><code>~/.hq/config.yaml</code><span class="label">Default file</span></span>
            <span class="layer glass-light"><code>HQ_CONFIG_PATH</code><span class="label">Override path</span></span>
            <span class="layer glass-light"><code>HQ_SECTION__KEY</code><span class="label">Env, __ nests</span></span>
            <span class="layer layer-final"><strong>One config, owner-only</strong><span class="label">Loaded</span></span>
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={processModel} /></details>
        </div>
      </section>

      <section id="crates" class="doc flip glass-heavy shine reveal" aria-labelledby="crates-h">
        <div class="prose">
          <p class="eyebrow">02</p>
          <h2 id="crates-h" class="h2-sm">Crate map</h2>
          <p>
            The workspace is Rust edition 2024 with 17 crates and about 143,000 lines of Rust. Foundations
            hold types, storage and the LLM clients. The agent crate holds the session loop, sub-agents,
            governance and the context engine. Services wrap those for a transport. <code>hq-host</code> and
            <code>hq-sandbox</code> run and confine coding agents. <code>hq-cli</code> ties them into the binary.
          </p>
          <p>
            The stack, in short: Tokio for async, Axum and tower-http for the web server, rusqlite (bundled,
            WAL mode) for storage, rmcp for MCP, serenity for Discord, teloxide for Telegram, clap for the CLI
            and figment for configuration. LLM calls go through async-openai with a swappable base URL, which
            is how OpenRouter, Ollama and other OpenAI-compatible backends plug in.
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz crates" role="img" aria-label="The 17 crates in five layers, lighting up from the foundations to the binary.">
            {
              crateRows.map(([layer, crates], i) => (
                <span class={`crow cr${i}`}>
                  <span class="label">{layer}</span>
                  <span class="crate-list">
                    {crates.map((c) => (
                      <code class={c === 'hq-cli' ? 'crate crate-top' : 'crate'}>{c}</code>
                    ))}
                  </span>
                </span>
              ))
            }
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={crateMap} /></details>
        </div>
      </section>

      <section id="vault" class="doc glass-heavy shine reveal" aria-labelledby="vault-h">
        <div class="prose">
          <p class="eyebrow">03</p>
          <h2 id="vault-h" class="h2-sm">The vault and the memory layers</h2>
          <p>
            The vault is a folder, <code>.vault/</code>, and it is the single source of truth. Notes, memory,
            skills and conversation threads are markdown with YAML frontmatter. One SQLite file,
            <code>.vault/_data/vault.db</code> in WAL mode, holds the indexes: FTS5 full-text search, embedding
            vectors, link graphs and the registries the daemon and relays need. Delete the database and the
            notes are still there.
          </p>
          <p>
            Embeddings come from OpenRouter when a key is set, and from Ollama (<code>nomic-embed-text</code>
            by default) when it is not. Memory, consolidation and skill review call the router under the
            aliases <code>dream</code>, <code>bulk</code> and <code>ingest</code>. Point those at a local model
            with a <code>backends:</code> block and they stay on your machine.
          </p>
          <h3>Memory</h3>
          <p>
            The <code>hq-memory</code> crate has an ingester, a consolidator, a querier, a forgetter and an
            entity graph. The daemon runs consolidation, embedding, note tagging and forgetting on its memory
            tier, so memory is something the vault does for itself over time, not a log that grows forever.
          </p>
          <h3>Context frames</h3>
          <p>
            Each turn, the context engine builds a token-budgeted frame from five layers: system, the user
            message, memory, thread and injections. Surplus tokens cascade between layers, with the thread
            getting 50 percent, injections 35 percent and memory 15 percent. Private tags are stripped from
            the memory layer, and older thread messages are compacted.
          </p>
          <h3>Who may see what</h3>
          <p>
            Notes and tasks can carry a label: private to named people, shared, public, or unmarked, which
            means owner only. A shared channel discloses only what every verified participant may see, and an
            unresolved identity is denied by default. <a href={links.sec.identity}>The design note</a> lists
            what is not covered yet.
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz budget-viz" role="img" aria-label="Surplus context budget per turn: thread 50 percent, injections 35 percent, memory 15 percent.">
            <span class="label">Surplus budget per turn</span>
            <span class="budget">
              <span class="b-thread">Thread 50%</span>
              <span class="b-inj">Injections 35%</span>
              <span class="b-mem">15%</span>
            </span>
            <span class="tags">
              <span class="pill glass-light">vault.db</span>
              <span class="pill glass-light">FTS5</span>
              <span class="pill glass-light">Embeddings</span>
              <span class="pill glass-light">Link graph</span>
            </span>
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={vaultMemory} /></details>
        </div>
      </section>

      <section id="daemon" class="doc flip glass-heavy shine reveal" aria-labelledby="daemon-h">
        <div class="prose">
          <p class="eyebrow">04</p>
          <h2 id="daemon-h" class="h2-sm">The daemon and its scheduled tasks</h2>
          <p>
            The daemon is a plain interval scheduler. It ticks every 5 seconds and runs whichever tasks are
            due, one after another, each with a timeout derived from its interval tier. A missed task is
            detected on the next start. After every tick it writes <code>DAEMON-STATUS.md</code> at the vault
            root, so you can read what ran with <code>cat</code>.
          </p>
          <p>
            The fast tier handles approvals, harness-session supervision, the heartbeat, value-bus delivery
            and the email poll. The memory tier handles consolidation, embeddings, note tagging and
            forgetting. The maintenance tier handles vault health, thread rotation, clean-up, a disk watchdog
            and SQLite vacuum. Beside the scheduler, an agent worker triages inbound events and email, and a
            machine profile records which CLIs the host has.
          </p>
          <p>Recurring prompts are not daemon tasks. They are <code>/watch</code> rows, covered with the relays below.</p>
        </div>
        <div class="doc-viz">
          <div class="viz tick-viz" role="img" aria-label="A five second tick runs the fast, memory and maintenance tier tasks in turn.">
            <span class="clock"><span class="hand"><i></i></span><span class="clock-face"><strong>5s</strong><span class="label">tick</span></span></span>
            <span class="tiers">
              <span class="tier"><span class="label">Fast</span><span class="tchips"><span class="tchip">Approvals</span><span class="tchip">Session supervision</span><span class="tchip">Heartbeat</span><span class="tchip">Email poll</span></span></span>
              <span class="tier"><span class="label">Memory</span><span class="tchips"><span class="tchip">Consolidation</span><span class="tchip">Embeddings</span><span class="tchip">Forgetting</span></span></span>
              <span class="tier"><span class="label">Maintenance</span><span class="tchips"><span class="tchip">Vault health</span><span class="tchip">Disk watchdog</span><span class="tchip">SQLite vacuum</span></span></span>
            </span>
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={daemon} /></details>
        </div>
      </section>

      <section id="relays" class="doc glass-heavy shine reveal" aria-labelledby="relays-h">
        <div class="prose">
          <p class="eyebrow">05</p>
          <h2 id="relays-h" class="h2-sm">Chat relays</h2>
          <p>
            Discord and Telegram are built into <code>hq-relay</code> as feature-gated bridges behind one
            unified bot. They share commands and watch firing, so behavior matches. Send <code>!cancel</code>
            in either and the agent stops at the next tool boundary and replies with a summary of turns and
            files touched. A heartbeat message shows the turn count and the tool currently running.
          </p>
          <p>
            Chat bridges are gated to an owner. Run <code>hq pair</code>, then send
            <code>/pair &lt;code&gt;</code> in a private Telegram chat or <code>!pair &lt;code&gt;</code> in a
            Discord DM. Earlier versions let the first sender become the owner. That was changed because it
            hands the agent to whoever messages first.
          </p>
          <h3>Turns that outlive the chat</h3>
          <p>
            A turn has an ack window, 270 seconds by default. If the turn runs longer, the chat gets an
            immediate acknowledgement and the session detaches into a persisted <code>background_turns</code>
            table, then delivers its result when it finishes. A reconciler runs at daemon start and every 6
            hours. It marks rows that were running when something died as interrupted, offers a
            <code>resume &lt;id&gt;</code>, and retires rows older than five days.
          </p>
          <p>
            <code>/watch &lt;minutes&gt; [for &lt;N&gt;h] &lt;prompt&gt;</code> stores a durable recurring
            turn in the same table, so watches survive restarts. A reply containing <code>WATCH_DONE</code>
            delivers once and stops the watch.
          </p>
          <h3>Session limits</h3>
          <p>
            Sessions have no turn-count ceiling. They end on completion, cancellation, an optional USD budget
            cap, or a wall-clock limit that defaults to five hours.
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz ack-viz" role="img" aria-label="A long turn passes the 270 second ack window, is acknowledged and detached to background_turns, then delivers its result.">
            <span class="ack-scale"><span class="label">Turn starts</span><span class="label">270 s ack window</span></span>
            <span class="ackbar"><span></span></span>
            <span class="detach glass-light"><strong>Acknowledged.</strong> Detached to <code>background_turns</code></span>
            <span class="deliver">Result delivered to the chat</span>
            <span class="tags"><span class="pill glass-light">!cancel</span><span class="pill glass-light">/watch</span><span class="pill glass-light">resume &lt;id&gt;</span></span>
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={channels} /></details>
        </div>
      </section>

      <section id="web" class="doc flip glass-heavy shine reveal" aria-labelledby="web-h">
        <div class="prose">
          <p class="eyebrow">06</p>
          <h2 id="web-h" class="h2-sm">The web PWA</h2>
          <p>
            The Control Center is a React 19 app on TanStack Start and Vite, built to a static single-page
            bundle. <code>hq start all</code> serves it from <code>:5678</code> along with the REST API and the
            chat socket, from <code>web/dist</code> next to the vault or the directory in
            <code>web_static_dir</code>. There is no separate web server process.
          </p>
          <p>
            It streams the agent live, browses and searches the vault, shows daemon status, runs the tasks
            views, lists and drives sessions, renders DOCX, XLSX and PDF, and takes push notifications. It
            installs on a phone like any PWA.
          </p>
          <h3>Auth in the browser</h3>
          <p>
            The server binds to <code>127.0.0.1</code> by default. With <code>web_auth_token</code> set, the
            token is accepted only as a Bearer header, never in a URL. A browser cannot set headers on a
            WebSocket, so the app asks <code>POST /api/ws-ticket</code> for a ticket that works once, lasts 30
            seconds and opens only <code>/ws</code>. An origin guard refuses requests from origins that are not
            loopback, not the server's own and not listed in <code>web_allowed_origins</code>, which also stops
            DNS rebinding. The response CSP has no <code>unsafe-eval</code> and no script
            <code>unsafe-inline</code>, and remote images are blocked on purpose, because an image URL is a way
            to send data out of a rendered note. Details: <a href={links.sec.webAuth}>web and MCP auth</a>.
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz ticket-viz" role="img" aria-label="The browser asks for a ticket, the ticket works once for 30 seconds, and it opens the chat socket.">
            <span class="token" aria-hidden="true"></span>
            <span class="flow4">
              <span class="fnode glass-light">Browser<code>Bearer</code></span>
              <span class="fnode glass-light">Ticket<code>POST /api/ws-ticket</code></span>
              <span class="fnode glass-light">Single use<span class="ttl"></span><code>30 s</code></span>
              <span class="fnode fnode-on">Chat socket<code>/ws</code></span>
            </span>
          </div>
        </div>
      </section>

      <section id="mcp" class="doc glass-heavy shine reveal" aria-labelledby="mcp-h">
        <div class="prose">
          <p class="eyebrow">07</p>
          <h2 id="mcp-h" class="h2-sm">The MCP server and the two-tool gateway</h2>
          <p>
            HQ is an MCP server so the agents you already use can reach your vault, tasks and sessions. A
            client always sees exactly two tools. <code>hq_discover</code> searches the registry by keyword
            and returns matching tools with their descriptions. <code>hq_call</code> runs a tool by name with
            JSON input. The registry behind them holds about a hundred tools, and a client that calls
            <code>hq_discover</code> at runtime always sees the live list.
          </p>
          <p>
            <code>hq mcp install --target claude-code</code> writes the client config for Claude Code, Claude
            Desktop, Cursor, VS Code, Copilot, OpenCode, Antigravity or a project file, and
            <code>hq mcp doctor</code> checks the connection.
          </p>
          <h3>Keys and scopes</h3>
          <p>
            Over HTTP, <code>/mcp</code> refuses every call unless a key is configured. There are three scopes.
            A full key sees everything. A read-only key sees an allowlist. A handoff key gets that read-only
            set, minus session logs, plus filing tasks, starting sessions and asking questions in read-only
            mode, and nothing else. The gateway sets the scope itself, so a client cannot claim a wider one.
            Treat the handoff key as the power to start a coding agent anywhere you allow it, and set
            <code>agent_host.handoff_cwd_allow</code> to bound where.
          </p>
          <h3>Both directions</h3>
          <p>
            HQ also bridges remote MCP servers. Each <code>remote_mcp:</code> entry becomes a
            <code>&lt;name&gt;_discover</code> and <code>&lt;name&gt;_call</code> pair in the registry, kept out
            of unattended sessions by default. From outside, <code>hq_ask</code> lets an MCP client put a
            question to HQ's own chat agent, in an ordinary web thread you can open and continue
            (<a href={links.mcpAsk}>docs</a>).
          </p>
        </div>
        <div class="doc-viz">
          <div class="viz mcp-viz" role="img" aria-label="Two gateway tools, hq_discover and hq_call, in front of a registry of about a hundred tools.">
            <span class="mcp-tools"><code class="pill pill-blue">hq_discover</code><code class="pill pill-green">hq_call</code></span>
            <span class="label">Registry, about 100 tools</span>
            <span class="dots">
              {mcpDots.map((h) => <span class={h >= 0 ? `md hit hd${h}` : 'md'}></span>)}
            </span>
          </div>
          <details class="more"><summary>Full diagram and text description</summary><Diagram d={mcpGateway} /></details>
        </div>
      </section>

      <section id="host" class="doc flip glass-heavy shine reveal" aria-labelledby="host-h">
        <div class="prose">
          <p class="eyebrow">08</p>
          <h2 id="host-h" class="h2-sm">The built-in host and supervised coding-agent sessions</h2>
          <p>
            HQ's built-in host (<code>hq host</code>) owns the terminals. It recognises which coding agent sits
            in a pane and reports its state: idle, working, blocked on a dialog, or done. HQ drives it over a
            local socket. Claude Code, Codex, Cursor, Pi, OpenCode, Copilot CLI, Kimi, Qwen and Antigravity are
            supported harnesses, and you can define your own profiles. This replaced an earlier tmux runner
            that could only guess state from screen text.
          </p>
          <h3>Personal agents</h3>
          <p>
            Hermes Agent and OpenClaw run in the same host as a second kind of harness, general-purpose agents.
            Every session has a purpose (research, review, monitor or general), and a request to give one code
            work is refused before anything starts. They get no HQ token and no MCP wiring: HQ types into them
            and reads their screen as untrusted text. Named in a <code>stack:</code> block, each pulls the tasks
            assigned to it and runs one as a single job, and the process ending puts the task into review. Setup
            and removal are in the <a href={links.personalAgents}>personal agents guide</a>.
          </p>
          <h3>Hosts</h3>
          <p>
            A host is a machine running <code>hq host</code>. <code>native</code> is the machine HQ runs on. Any
            other host is a machine you paired with <code>hq host join</code> and is reached over ssh with a
            dedicated key that is pinned to one source address and to a forced command,
            <code>hq host gate</code>, which accepts one request as JSON on stdin and refuses every method
            outside an allowlist. Agents run in a process sandbox with an egress allowlist. That is how HQ on a
            VPS can run and watch agents on a laptop, whenever the laptop is on and reachable. Connections are
            reused between calls, and a write is never retried because the gate may already have run it.
          </p>
          <h3>Spawning and watching</h3>
          <p>
            <code>harness_session_spawn</code> starts an agent and returns a session id. Send, wait, logs,
            status, stop and resume sit beside it, and <code>hq sessions</code> mirrors them in the CLI. A
            supervisor in the daemon polls every host once a minute. It alerts once when a session blocks and
            once when an agent finishes a turn. A host that cannot be reached counts as unknown, never as
            exited: a sleeping laptop leaves its sessions running and they are watched again when it answers.
          </p>
          <p>
            HQ does not answer dialogs for you. Claude Code's workspace-trust prompt defaults to "No, exit", so
            pressing Enter would quit it. A blocked launch is reported with the screen, and you answer with
            explicit keys.
          </p>
          <h3>Sessions that work on a task</h3>
          <p>
            A session can be linked to a task. Each event leaves a task comment, and the task moves from in
            progress to ready for review or blocked as the session finishes or exits. HQ never marks a task
            complete, because an agent saying it is done is not verification. Comments never quote the pane,
            since pane text is untrusted input.
          </p>
          <h3>Handoff</h3>
          <p>
            <code>harness_session_handoff</code> lets an outside client, such as another agent over MCP, start
            tracked work in one call. It files or reuses a task by an idempotency key, starts one linked
            session with the acceptance criteria as its definition of done, and opens a chat thread that owns
            the session. It is idempotent: the same key returns the same task, and a task that already has a
            running session gets no second one.
          </p>
          <h3>Watching and driving from a web chat</h3>
          <p>
            A chat can watch a session. Watching posts short updates and never quotes the screen. Driving lets
            HQ act as the session's project manager: read the session, send the next instruction, approve a
            permission prompt or resume an exit, toward the linked task's goal. It asks you instead when a step
            is destructive, touches credentials, deploys or spends money. A new watch starts with Drive on only
            when the task gives it a usable goal, and observation-only otherwise. A turn that has read untrusted
            content starts new watches with Drive off, and a tool can never turn it back on once you switched it
            off. Mechanical limits cut it off without relying on the model: an instruction budget per session,
            a cap on key presses, a no-progress guard, and a cap on sessions driven at once. Each one switches
            Drive off and says why. The Sessions page shows every session with its task, host, goal and live
            state.
          </p>
          <p class="small">Full reference, including setup and troubleshooting: <a href={links.agentSessions}>docs/AGENT_SESSIONS.md</a>.</p>
        </div>
