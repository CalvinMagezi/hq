---
import Layout from '../layouts/Layout.astro';

const pages = [
  { href: '/', label: 'Home', note: 'One agent, every channel' },
  { href: '/architecture/', label: 'Architecture', note: 'How it is built' },
  { href: '/compare/', label: 'Compare', note: 'Next to OpenClaw and Hermes Agent' },
  { href: '/install/', label: 'Install', note: 'Seven ways in' },
  { href: '/security/', label: 'Security', note: 'What holds and what does not' },
];
---

<Layout title="Page not found" description="This page does not exist on the Agent HQ site. Use the links on this page to find what you were looking for." path="/404/" noindex>
  <section class="sec sec-hero lost-sec" aria-labelledby="nf-h">
    <span class="orb orb-b o-tl" aria-hidden="true"></span>
    <span class="orb orb-g o-br slow" aria-hidden="true"></span>
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <div class="container stack center">
      <div class="lost" aria-hidden="true">
        <span class="digit">4</span>
        <span class="pair-lost"><span class="cb"></span><span class="cg"></span></span>
        <span class="digit">4</span>
      </div>
      <div class="stack-sm center">
        <p class="eyebrow">404</p>
        <h1 id="nf-h">That page is not here</h1>
        <p class="lede">The link may be old or mistyped. These pages exist.</p>
      </div>
      <ul class="go list-plain">
        {
          pages.map((p) => (
            <li>
              <a class="glass-heavy shine" href={p.href}>
                {p.label}
                <span>{p.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .lost-sec {
    min-height: 80vh;
  }
  .center {
    align-items: center;
    text-align: center;
  }
  h1 {
    font-size: 44px;
    line-height: 48px;
  }
  .lost {
    position: relative;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .digit {
    font-size: 240px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.22);
  }
  .pair-lost {
    position: relative;
    width: 200px;
    height: 200px;
  }
  .cb,
  .cg {
    position: absolute;
    top: 50%;
    width: 150px;
    height: 150px;
    margin-top: -75px;
    border-radius: 50%;
  }
  .cb {
    left: -30px;
    background: var(--brand-blue);
  }
  .cg {
    right: -30px;
    background: var(--brand-green);
  }
  .go {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    text-align: left;
  }
  .go a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 20px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    font-size: 18px;
    min-height: 96px;
  }
  .go a span {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .go a:hover {
    border-color: rgba(34, 255, 55, 0.45);
  }
  @media (max-width: 960px) {
    .go {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .digit {
      font-size: 160px;
    }
    .pair-lost {
      width: 140px;
      height: 140px;
    }
    .cb,
    .cg {
      width: 104px;
      height: 104px;
      margin-top: -52px;
    }
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 32px;
      line-height: 38px;
    }
    .lost {
      gap: 12px;
      height: 180px;
    }
    .digit {
      font-size: 96px;
    }
    .pair-lost {
      width: 80px;
      height: 80px;
    }
    .cb,
    .cg {
      width: 60px;
      height: 60px;
      margin-top: -30px;
    }
    .cb {
      left: -14px;
    }
    .cg {
      right: -14px;
    }
    .go {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @keyframes seekL {
    0%,
    100% {
      transform: translateX(-30px);
    }
    45%,
    55% {
      transform: translateX(36px);
    }
    50% {
      transform: translateX(30px);
    }
  }
  @keyframes seekR {
    0%,
    100% {
      transform: translateX(30px);
    }
    45%,
    55% {
      transform: translateX(-36px);
    }
    50% {
      transform: translateX(-30px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cb {
      animation: seekL 5s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
    .cg {
      animation: seekR 5s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
  }
</style>
