---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page does not exist on the Agent HQ site. Use the links on this page to find what you were looking for." path="/404/" noindex>
  <section class="section">
    <div class="container prose">
      <span class="eyebrow">404</span>
      <h1>That page is not here</h1>
      <p class="lede">The link may be old or mistyped. These pages exist.</p>
      <ul class="facts">
        <li><a href="/">Home</a></li>
        <li><a href="/architecture/">Architecture</a></li>
        <li><a href="/compare/">Compare</a></li>
        <li><a href="/install/">Install</a></li>
        <li><a href="/security/">Security</a></li>
      </ul>
    </div>
  </section>
</Layout>
