---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import manifest from '../data/media.json';
import { links, SITE_URL } from '../data/site';

const installCmd = 'curl -fsSL https://agent-hq.online/install.sh | bash';

const agents = ['Claude Code', 'Codex', 'Cursor', 'OpenCode', 'Pi', 'Copilot CLI', 'Kimi', 'Qwen', 'Antigravity'];
const reach = ['Discord', 'Telegram', 'Web app', 'Terminal', 'MCP server', 'Markdown vault', 'Signed releases', 'Sub-agents'];

const SCREEN_IDS = ['dashboard', 'sessions-list', 'tasks-board', 'vault-browser'];
const SCREEN_LABELS: Record<string, string> = {
  dashboard: 'Home',
  'sessions-list': 'Sessions',
  'tasks-board': 'Tasks',
  'vault-browser': 'Vault',
};
const screens = SCREEN_IDS.map((id) => manifest.find((m) => m.id === id)!);
---

<Layout
  title="Agent HQ: a local-first AI agent hub"
  description="Open-source AI agent hub on Discord, Telegram, web and terminal. A markdown vault on your machine, supervised coding agents, one Rust binary."
  path="/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Agent HQ',
    alternateName: 'HQ',
    description: 'Open-source, local-first AI agent hub that supervises coding agents and keeps a markdown vault on your own machine.',
    url: SITE_URL,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS',
    license: 'https://opensource.org/license/mit',
    codeRepository: links.repo,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <section class="sec sec-hero" aria-labelledby="hero-h" data-spotlight>
    <span class="orb orb-b o-tl" aria-hidden="true"></span>
    <span class="orb orb-g o-br slow" aria-hidden="true"></span>
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <span class="spot" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="stack">
        <div class="tags">
          <span class="tag tag-green">Open source</span>
          <span class="tag tag-blue">Local first</span>
          <span class="tag glass-light">Version 0.9.x</span>
        </div>
        <h1 id="hero-h" class="display">
          <span class="hl"><span>One agent.</span></span>
          <span class="hl"><span>Every channel.</span></span>
          <span class="hl"><span class="accent">Your machine.</span></span>
        </h1>
        <div class="rule rule-in" aria-hidden="true"></div>
        <p class="lede fade-in hero-lede">
          Agent HQ (HQ for short) puts one AI agent on Discord, Telegram, a web app and your terminal. It
          keeps your data in a markdown vault on your own disk and supervises the coding agents you already
          use. One Rust binary of about 58 MB. No cloud backend.
        </p>
        <div class="install-pill glass fade-in">
          <span class="prompt" aria-hidden="true">$</span>
          <code id="hero-install">{installCmd}</code>
          <button type="button" class="btn btn-accent btn-sm" data-copy="hero-install" data-label="Copy" aria-label="Copy install command" hidden>Copy</button>
        </div>
        <div class="actions fade-in">
          <a class="btn btn-primary btn-lg" href="/install/">Install guide</a>
          <a class="btn btn-lg" href="/architecture/">How it works</a>
          <a class="btn btn-lg" href={links.repo}>View on GitHub</a>
        </div>
      </div>

      <div class="graphic-panel glass-heavy shine">
        <div class="graphic" role="img" aria-label="Four channels, Discord, Telegram, the web app and the terminal, flow into one agent, which writes to your vault.">
          <svg class="track" viewBox="0 0 560 440" aria-hidden="true" focusable="false">
            <path d="M150 60 C 230 60 220 210 300 210"></path>
            <path d="M150 160 C 230 160 220 210 300 210"></path>
            <path d="M150 260 C 230 260 220 210 300 210"></path>
            <path d="M150 360 C 230 360 220 210 300 210"></path>
            <path d="M368 210 L 420 210"></path>
          </svg>
          <span class="flow-dot fd1"></span>
          <span class="flow-dot fd2"></span>
          <span class="flow-dot fd3"></span>
          <span class="flow-dot fd4"></span>
          <span class="flow-dot fd5"></span>
          <span class="ch glass-light ch1"><span class="ping ping-blue"></span>Discord</span>
          <span class="ch glass-light ch2"><span class="ping ping-green"></span>Telegram</span>
          <span class="ch glass-light ch3"><span class="ping ping-blue"></span>Web app</span>
          <span class="ch glass-light ch4"><span class="ping ping-green"></span>Terminal</span>
          <svg class="core" viewBox="0 0 136 88" aria-hidden="true" focusable="false">
            <defs><clipPath id="core-clip"><circle cx="44" cy="44" r="44"></circle></clipPath></defs>
            <circle class="c-blue" cx="44" cy="44" r="44"></circle>
            <circle class="c-green" cx="92" cy="44" r="44"></circle>
            <circle class="c-ground" cx="92" cy="44" r="44" clip-path="url(#core-clip)"></circle>
          </svg>
          <span class="g-label core-label">One agent</span>
          {[1, 2, 3, 4, 5, 6].map((n) => <span class={`vbar vb${n}`}><span></span></span>)}
          <span class="g-label vault-label">Your vault</span>
          <span class="vault-path">.vault/*.md</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec-band" aria-label="Coding agents and channels HQ works with">
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <div class="container">
      <div class="band glass shine">
        <div class="band-head">
          <p class="eyebrow band-title">Supervises the coding agents you already use</p>
          <button type="button" class="btn btn-sm mq-pause" data-marquee-pause aria-pressed="false" hidden>Pause</button>
        </div>
        <div class="marquee">
          <div class="mq-track">
            {
              [false, true].map((dup) => (
                <ul class="mq-group" aria-hidden={dup ? 'true' : undefined}>
                  {agents.map((a) => (
                    <li class="mq-item">
                      {a}
                      <svg class="mq-pair" viewBox="0 0 28 16" aria-hidden="true" focusable="false">
                        <circle class="c-blue" cx="8" cy="8" r="8" />
                        <circle class="c-green" cx="20" cy="8" r="8" />
                      </svg>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
        <div class="marquee">
          <div class="mq-track mq-rev">
            {
              [false, true].map((dup) => (
                <ul class="mq-group" aria-hidden={dup ? 'true' : undefined}>
                  {reach.map((r) => (
                    <li class="mq-item mq-sm">
                      {r}
                      <span class="dot dot-blue" aria-hidden="true"></span>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="fit-h">
    <span class="orb orb-b o-tr slow" aria-hidden="true"></span>
    <span class="orb orb-g o-bl" aria-hidden="true"></span>
    <div class="container fit-grid">
      <div class="stack">
        <p class="eyebrow reveal">How it fits together</p>
        <h2 id="fit-h" class="reveal">Four ways in, one agent, one vault</h2>
        <p class="lede reveal">
          Every channel reaches the same agent loop, and the agent reads and writes the same vault. That is
          the whole idea. The <a href="/architecture/">architecture page</a> goes through each part.
        </p>
        <ol class="rail-steps">
          <li class="rail" aria-hidden="true"><span></span></li>
          <li class="gcard reveal">
            <span class="step-dot dot-blue" aria-hidden="true"></span>
            <h3>Ask from anywhere</h3>
            <p class="body">Discord, Telegram, the web app and your terminal share one conversation history and one memory. Start a thread on your phone and finish it at your desk.</p>
          </li>
          <li class="gcard reveal reveal-2">
            <span class="step-dot dot-green" aria-hidden="true"></span>
            <h3>One agent does the work</h3>
            <p class="body">Sub-agents run single, parallel, race or graph. Long turns detach and report back when they finish.</p>
          </li>
          <li class="gcard reveal reveal-3">
            <span class="step-dot dot-sky" aria-hidden="true"></span>
            <h3>Everything lands in your vault</h3>
            <p class="body">Notes, memory, skills and threads are plain markdown on your disk, plus one SQLite database for search.</p>
          </li>
        </ol>
      </div>
      <div class="art glass-heavy shine zoom-in">
        <div class="art-in">
          <img
            class="parallax"
            src="/media/art/four-doors.jpg"
            alt="Flat isometric illustration: four doorways shaped like a speech bubble, a paper plane, a browser window and a terminal, all opening onto one shared room with a round table."
            width="1600"
            height="995"
            loading="lazy"
            decoding="async"
          />
          <ul class="door-chips" aria-hidden="true">
            <li class="dchip glass-heavy"><span class="dot dot-blue"></span>Discord</li>
            <li class="dchip glass-heavy"><span class="dot dot-green"></span>Telegram</li>
            <li class="dchip glass-heavy"><span class="dot dot-blue"></span>Web app</li>
            <li class="dchip glass-heavy"><span class="dot dot-green"></span>Terminal</li>
            <li class="dchip dchip-room">One room: your agent</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-top0" aria-labelledby="cap-h">
    <span class="orb orb-i o-ml slow" aria-hidden="true"></span>
    <span class="orb orb-b o-mr" aria-hidden="true"></span>
    <span class="orb orb-g o-bl slow" aria-hidden="true"></span>
    <div class="container stack">
      <div class="head">
        <p class="eyebrow reveal">What it does</p>
        <h2 id="cap-h" class="reveal">What HQ is built around</h2>
        <div class="rule rule-sm sweep" aria-hidden="true"></div>
      </div>
      <div class="bento">
        <article class="gcard span2 reveal">
          <div class="stage" aria-hidden="true">
            <span class="ring"></span>
            <span class="orbit"><i class="od1"></i><i class="od2"></i><i class="od3"></i><i class="od4"></i></span>
            <svg class="stage-pair" viewBox="0 0 56 36" aria-hidden="true" focusable="false"><circle class="c-blue" cx="18" cy="18" r="18" /><circle class="c-green" cx="38" cy="18" r="18" /></svg>
            <span class="mini glass-light m1">Discord</span>
            <span class="mini glass-light m2">Telegram</span>
            <span class="mini glass-light m3">Web app</span>
            <span class="mini glass-light m4">Terminal</span>
          </div>
          <h3>One agent on every channel</h3>
          <p class="body">Discord, Telegram, a web app that installs as a PWA, and your terminal share one conversation history and one memory. Start a thread on your phone and finish it at your desk.</p>
        </article>

        <article class="gcard reveal reveal-2">
          <div class="stage stage-bars" aria-hidden="true">
            <span class="mbar"><span class="fill-blue"></span></span>
            <span class="mbar w82"><span class="fill-green"></span></span>
            <span class="mbar w92"><span class="fill-blue"></span></span>
            <span class="mbar w60"><span class="fill-green"></span></span>
          </div>
          <h3>A vault you can read</h3>
          <p class="body">Notes, memory, skills and threads are plain markdown files on your disk, plus one SQLite database for full-text search and embeddings. Nothing is locked inside a service.</p>
        </article>

        <article class="gcard reveal">
          <div class="stage" aria-hidden="true">
            <div class="term-mini glass-light">
              <span class="tline w70"></span>
              <span class="tline w46"></span>
              <span class="tline w62"></span>
              <span class="tprompt"><span>$</span><span class="cursor"></span></span>
            </div>
            <span class="chip">Blocked</span>
          </div>
          <h3>Coding agents under supervision</h3>
          <p class="body">Start, watch, steer and resume Claude Code, Codex, OpenCode and others inside the built-in host, on this machine or a paired one. HQ tells you when one blocks. It never answers a trust prompt for you.</p>
        </article>

        <article class="gcard reveal reveal-2">
          <div class="stage" aria-hidden="true">
            <div class="cols"><span class="col">To do</span><span class="col">In progress</span><span class="col">Complete</span></div>
            <span class="mover"><i class="w80"></i><i class="w50"></i></span>
          </div>
          <h3>Tasks and sub-agents</h3>
          <p class="body">Spaces, initiatives, tasks and comments are built in, with list, board and timeline views. Sub-agents run single, parallel, race or graph. Long turns detach and report back, and /watch schedules recurring ones.</p>
        </article>

        <article class="gcard reveal reveal-3">
          <div class="stage" aria-hidden="true">
            <div class="lines"><i class="w88"></i><i class="w64 hit"></i><i class="w76"></i><i class="w52"></i></div>
            <span class="lens"></span>
          </div>
          <h3>Web search with nothing to set up</h3>
          <p class="body">web_search queries Google, DuckDuckGo, Brave, Mojeek and engines for news, science, images and code, all inside the hq process. No key, no Docker. Blocked engines are suspended and remembered, and a server on a blocked address can ask a peer HQ.</p>
        </article>

        <article class="gcard reveal">
          <div class="stage" aria-hidden="true">
            <span class="node glass-light"></span>
            <span class="label node-l">Client</span>
            <span class="link"></span>
            <span class="packet"></span>
            <svg class="node-hq" viewBox="0 0 64 44" aria-hidden="true" focusable="false"><circle class="c-blue" cx="22" cy="22" r="22" /><circle class="c-green" cx="42" cy="22" r="22" /></svg>
            <span class="label node-r">HQ</span>
          </div>
          <h3>An MCP server for your tools</h3>
          <p class="body">Two tools, hq_discover and hq_call, open the whole registry to Claude Code, Cursor, VS Code, Copilot and other MCP clients. Remote MCP servers can be bridged in the other direction.</p>
        </article>

        <article class="gcard gcard-indigo span2 reveal reveal-2">
          <div class="stage stage-safe" aria-hidden="true">
            <span class="scan"></span>
            <svg class="shield" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z M9 12l2 2 4-4"></path></svg>
            <span class="safe-tags">
              <span class="tag tag-green">Bash sandbox</span>
              <span class="tag tag-blue">Env allowlist</span>
              <span class="tag tag-light">Signed releases</span>
            </span>
          </div>
          <h3>Safe by default</h3>
          <p class="body">Agent shell commands run in a sandbox with an environment allowlist. Untrusted content taints a session and cuts off secrets and outbound network. Servers update from signed releases and roll back on a failed health check.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="see-h">
    <span class="see-glow" aria-hidden="true"></span>
    <div class="container stack" data-tabs>
      <div class="see-head">
        <div class="head">
          <p class="eyebrow reveal">See it</p>
          <h2 id="see-h" class="reveal">The web app, on your own server</h2>
        </div>
        <div class="seg glass-heavy" role="group" aria-label="Choose a screen" data-tablist hidden>
          <span class="seg-ind" aria-hidden="true"></span>
          {
            screens.map((s, i) => (
              <button type="button" data-tab={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {SCREEN_LABELS[s.id]}
              </button>
            ))
          }
        </div>
      </div>
      <div class="screens">
        {
          screens.map((s) => (
            <figure class="screen" data-panel={s.id} data-glow={s.id}>
              <div class="frame-3d">
                <div class="frame glass-heavy shine tilt">
                  <span class="chrome" aria-hidden="true"><i></i><i></i><i></i></span>
                  <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
                </div>
              </div>
              <figcaption class="small">{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="media-pair">
        <div class="gcard reveal"><Media id="session-watch" /></div>
        <div class="gcard reveal reveal-2"><Media id="terminal-install" /></div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="local-h">
    <span class="orb orb-g o-tr" aria-hidden="true"></span>
    <span class="orb orb-i o-bl slow" aria-hidden="true"></span>
    <div class="container local-grid">
      <div class="stack">
        <p class="eyebrow reveal">Local first</p>
        <h2 id="local-h" class="reveal">Your data is a folder you can open</h2>
        <p class="lede reveal">
          Notes, memory, skills and threads are plain markdown files on your disk, plus one SQLite database
          for full-text search and embeddings. Nothing is locked inside a service.
        </p>
        <div class="tags reveal">
          <span class="tag tag-indigo">Markdown vault</span>
          <span class="tag tag-blue">SQLite and FTS5</span>
          <span class="tag tag-green">No cloud backend</span>
        </div>
      </div>
      <div class="local-art">
        <div class="art glass-heavy shine zoom-in">
          <div class="art-in">
            <img
              class="parallax"
              src="/media/art/local-first.jpg"
              alt="Flat isometric illustration: a laptop on a desk whose screen spills a stack of document cubes that grow into a small block city."
              width="1600"
              height="995"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <ul class="tree glass-heavy shine" aria-label="Example vault folder">
          <li class="t-root">.vault/</li>
          <li class="tr1">Notebooks/</li>
          <li class="tr1">skills/</li>
          <li class="tr1">_mailboxes/</li>
          <li class="tr1">_data/</li>
          <li class="tr2">vault.db</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="inst-h">
    <span class="orb orb-b o-c" aria-hidden="true"></span>
    <span class="orb orb-g o-bl slow" aria-hidden="true"></span>
    <div class="container install-grid">
      <div class="stack">
        <p class="eyebrow reveal">Install</p>
        <h2 id="inst-h" class="reveal">Three commands from a clone</h2>
        <p class="lede reveal">
          Build the binary, scaffold a vault, check the setup. You need a recent stable Rust toolchain and
          at least one LLM API key. Servers have a separate path with signed releases.
        </p>
        <ol class="isteps list-plain">
          <li class="istep glass reveal"><span class="num num-blue">01</span><span class="istep-text"><span>Build the binary</span><code id="strip-build">cargo build --release -p hq-cli</code></span><button type="button" class="btn btn-sm" data-copy="strip-build" data-label="Copy" aria-label="Copy build command" hidden>Copy</button></li>
          <li class="istep glass reveal reveal-2"><span class="num num-green">02</span><span class="istep-text"><span>Scaffold a vault</span><code id="strip-install">./target/release/hq install</code></span><button type="button" class="btn btn-sm" data-copy="strip-install" data-label="Copy" aria-label="Copy scaffold command" hidden>Copy</button></li>
          <li class="istep glass reveal reveal-3"><span class="num num-indigo">03</span><span class="istep-text"><span>Check the setup</span><code id="strip-doctor">./target/release/hq doctor</code></span><button type="button" class="btn btn-sm" data-copy="strip-doctor" data-label="Copy" aria-label="Copy check command" hidden>Copy</button></li>
        </ol>
        <div class="actions"><a class="btn" href="/install/">All install options</a></div>
      </div>
      <div class="tw glass-heavy shine zoom-in" role="img" aria-label="A terminal typing the three commands: cargo build --release -p hq-cli, ./target/release/hq install, ./target/release/hq doctor.">
        <div class="tw-bar" aria-hidden="true"><i></i><i></i><i></i><span>~/hq</span></div>
        <div class="tw-body" aria-hidden="true">
          <div class="tw-line"><span class="p">$</span><span class="type t1">cargo build --release -p hq-cli</span></div>
          <div class="tw-line l2"><span class="p">$</span><span class="type t2">./target/release/hq install</span></div>
          <div class="tw-line l3"><span class="p">$</span><span class="type t3">./target/release/hq doctor</span><span class="blink"></span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-top0" aria-labelledby="early-h">
    <span class="orb orb-g o-tl" aria-hidden="true"></span>
    <span class="orb orb-b o-br slow" aria-hidden="true"></span>
    <div class="container">
      <div class="early gcard gcard-indigo shine reveal">
        <div class="stack-sm">
          <p class="eyebrow">Version 0.9.x</p>
          <h2 id="early-h">HQ is early</h2>
        </div>
        <div class="stack-sm">
          <p>
            Expect rough edges and changes between releases. Defaults have tightened since 0.9.0: the bash
            sandbox is now required by default, and chat relays no longer adopt the first sender as owner.
          </p>
          <p>
            It talks to Discord and Telegram, not Slack or WhatsApp. Signed release binaries are built for
            Linux (x86_64 and ARM) and for Apple Silicon Macs; Intel Macs build from source. The
            <a href={links.changelog}>changelog</a> lists every upgrade note.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(520px circle at var(--mx, 78%) var(--my, 45%), rgba(0, 173, 238, 0.11), transparent 62%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
  }
  .hero-lede {
    max-width: 560px;
  }
  .install-pill {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: 26px;
    padding: 6px 6px 6px 20px;
    max-width: 560px;
  }
  .install-pill .prompt {
    color: var(--text-green);
    font-family: var(--font-mono);
  }
  .install-pill code {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 14px;
    background: none;
    border: 0;
    padding: 0;
  }

  .graphic-panel {
    border-radius: var(--radius-xl);
    padding: 28px;
  }
  .graphic {
    position: relative;
    width: 560px;
    height: 440px;
    zoom: 0.86;
  }
  .track {
    position: absolute;
    inset: 0;
    width: 560px;
    height: 440px;
    pointer-events: none;
  }
  .track path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 2;
    stroke-dasharray: 4 6;
  }
  .flow-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0;
    offset-rotate: 0deg;
  }
  .fd1 {
    offset-path: path('M150 60 C 230 60 220 210 300 210');
    background: var(--brand-blue);
    box-shadow: 0 0 12px var(--brand-blue);
  }
  .fd2 {
    offset-path: path('M150 160 C 230 160 220 210 300 210');
    background: var(--brand-green);
    box-shadow: 0 0 12px var(--brand-green);
    animation-delay: 0.7s;
  }
  .fd3 {
    offset-path: path('M150 260 C 230 260 220 210 300 210');
    background: var(--brand-blue);
    box-shadow: 0 0 12px var(--brand-blue);
    animation-delay: 1.4s;
  }
  .fd4 {
    offset-path: path('M150 360 C 230 360 220 210 300 210');
    background: var(--brand-green);
    box-shadow: 0 0 12px var(--brand-green);
    animation-delay: 2.1s;
  }
