---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import manifest from '../data/media.json';
import { links, SITE_URL } from '../data/site';

const installCmd = 'curl -fsSL https://agent-hq.online/install.sh | bash';

const agents = ['Claude Code', 'Codex', 'Cursor', 'OpenCode', 'Pi', 'Copilot CLI', 'Kimi', 'Qwen', 'Antigravity', 'Hermes Agent', 'OpenClaw'];
const reach = ['Discord', 'Telegram', 'Web app', 'Terminal', 'MCP server', 'Markdown vault', 'Signed releases', 'Sub-agents'];

const SCREEN_IDS = ['dashboard', 'sessions-list', 'tasks-board', 'vault-browser'];
const SCREEN_LABELS: Record<string, string> = {
  dashboard: 'Home',
  'sessions-list': 'Sessions',
  'tasks-board': 'Tasks',
  'vault-browser': 'Vault',
};
const screens = SCREEN_IDS.map((id) => manifest.find((m) => m.id === id)!);

const hosts = [
  {
    name: 'An Android phone',
    where: 'Download the app (Android 8+)',
    body: 'The home base. The daemon, chat, tasks, notes, inbox and both chat relays run on it, with a data saver for metered plans. Keep it on a charger. Coding agents run on your laptop or server, and the phone supervises them.',
    href: '#phone-h',
    tone: 'green',
    preview: true,
  },
  {
    name: 'Your laptop or desktop',
    where: 'macOS (Apple Silicon and Intel) or Linux',
    body: 'Joins your phone with a QR code and runs your coding agents. One command installs a signed binary and the web app. On a Mac, hq service install keeps the daemon running and starts it at login.',
    cmd: 'curl -fsSL https://agent-hq.online/install.sh | bash',
    tone: 'blue',
  },
  {
    name: 'Windows',
    where: 'Full HQ in WSL2, or HQ Lite with no admin rights',
    body: 'The PowerShell installer asks which one you want. Lite keeps your notes, tasks and web app, and never makes a network call it does not list.',
    cmd: 'irm https://agent-hq.online/install.ps1 | iex',
    tone: 'blue',
  },
  {
    name: 'A server',
    where: 'Any Linux VPS, or a Hetzner server from a short form',
    body: 'Always on, updates itself from signed releases every ten minutes and rolls back when a health check fails. Pair it with your phone like a laptop, or run it on its own.',
    href: '/install/#server',
    tone: 'green',
  },
  {
    name: 'Docker',
    where: 'One container, amd64 and arm64',
    body: 'The image runs HQ with its web app and prints a sign-in link on first start. The vault lives in a volume.',
    cmd: 'docker run -d -p 127.0.0.1:5678:5678 -v hq-data:/data ghcr.io/calvinmagezi/hq',
    tone: 'indigo',
  },
];

const phoneShots = [
  { id: 'chat-working', label: 'Chat', alt: 'Phone screen: a chat where HQ answers a question, then lists the steps it is taking: checked your tasks, read a note, writing the steps.' },
  { id: 'tasks-today', label: 'Tasks', alt: 'Phone screen: the Today tab of Tasks, with tasks waiting on you, one ready to check, and work in progress.' },
  { id: 'inbox-needs-you', label: 'Inbox', alt: 'Phone screen: the Inbox, where a coding agent asks to edit one file and HQ offers Allow once or Not now.' },
  { id: 'helper-working', label: 'Helpers', alt: 'Phone screen: a coding agent on a Mac mini building an app, with what it has done so far and a field to tell it something.' },
  { id: 'note-reading', label: 'Notes', alt: 'Phone screen: a note from the vault open for reading, with Ask HQ, Make a task and Pin actions.' },
  { id: 'keep-running', label: 'Keep running', alt: 'Phone screen: Keep running, which checks the Android battery and permission settings that let HQ stay on.' },
];
---

<Layout
  title="Agent HQ: a mobile-first AI agent harness"
  description="Open-source AI agent harness that lives on your phone. Laptops and servers join with a QR code and talk directly, no VPN. Supervised coding agents, a markdown vault you can open, one Rust binary."
  path="/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Agent HQ',
    alternateName: 'HQ',
    description: 'Open-source, mobile-first AI agent harness. HQ lives on your phone, your laptop and servers join with a QR code, and it supervises coding agents and keeps a markdown vault you can open.',
    url: SITE_URL,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows, Android',
    license: 'https://opensource.org/license/mit',
    codeRepository: links.repo,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <section class="sec sec-hero" aria-labelledby="hero-h" data-spotlight>
    <span class="orb orb-b o-tl" aria-hidden="true"></span>
    <span class="orb orb-g o-br slow" aria-hidden="true"></span>
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <span class="spot" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="stack">
        <div class="tags">
          <span class="tag tag-green">Open source</span>
          <span class="tag tag-blue">Mobile first</span>
          <span class="tag glass-light">Version 0.9.x</span>
        </div>
        <h1 id="hero-h" class="display">
          <span class="hl"><span>Your AI agents.</span></span>
          <span class="hl"><span>Your phone.</span></span>
          <span class="hl"><span class="accent">Every machine.</span></span>
        </h1>
        <div class="rule rule-in" aria-hidden="true"></div>
        <p class="lede fade-in hero-lede">
          Agent HQ (HQ for short) lives on your phone. Your laptop and servers join it with a QR code and
          talk to it directly, with no VPN to set up. Coding agents run on those machines, and your phone
          starts them, watches them and answers their questions. Your data stays in a markdown vault you can
          open. One Rust binary, no cloud backend.
        </p>
        <p class="small fade-in">On your laptop or server:</p>
        <div class="install-pill glass fade-in">
          <span class="prompt" aria-hidden="true">$</span>
          <code id="hero-install">{installCmd}</code>
          <button type="button" class="btn btn-accent btn-sm" data-copy="hero-install" data-label="Copy" aria-label="Copy install command" hidden>Copy</button>
        </div>
        <div class="actions fade-in">
          <a class="btn btn-primary btn-lg" href="https://github.com/CalvinMagezi/hq/releases/latest/download/agent-hq-android.apk">Download for Android</a>
          <a class="btn btn-lg" href="/architecture/">How it works</a>
          <a class="btn btn-lg" href={links.repo}>View on GitHub</a>
        </div>
      </div>

      <div class="graphic-panel glass-heavy shine">
        <div class="graphic" role="img" aria-label="Your phone runs HQ and holds the vault. A laptop, a server or VPS, Claude Code and chat on Telegram or Discord all connect to it.">
          <svg class="track" viewBox="0 0 560 440" aria-hidden="true" focusable="false">
            <path d="M150 60 C 230 60 220 210 300 210"></path>
            <path d="M150 160 C 230 160 220 210 300 210"></path>
            <path d="M150 260 C 230 260 220 210 300 210"></path>
            <path d="M150 360 C 230 360 220 210 300 210"></path>
            <path d="M348 210 L 420 210"></path>
          </svg>
          <span class="flow-dot fd1"></span>
          <span class="flow-dot fd2"></span>
          <span class="flow-dot fd3"></span>
          <span class="flow-dot fd4"></span>
          <span class="flow-dot fd5"></span>
          <span class="ch glass-light ch1"><span class="ping ping-blue"></span>Laptop</span>
          <span class="ch glass-light ch2"><span class="ping ping-green"></span>Server / VPS</span>
          <span class="ch glass-light ch3"><span class="ping ping-blue"></span>Claude Code</span>
          <span class="ch glass-light ch4"><span class="ping ping-green"></span>Chat</span>
          <img class="core" src="/icons/hq-icon-192.png" alt="" width="96" height="96" decoding="async" />
          <span class="g-label core-label">Phone (HQ)</span>
          {[1, 2, 3, 4, 5, 6].map((n) => <span class={`vbar vb${n}`}><span></span></span>)}
          <span class="g-label vault-label">Your vault</span>
          <span class="vault-path">.vault/*.md</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec-band" aria-label="Coding agents, personal agents and channels HQ works with">
    <span class="orb orb-i o-c" aria-hidden="true"></span>
    <div class="container">
      <div class="band glass shine">
        <div class="band-head">
          <p class="eyebrow band-title">Supervises the coding and personal agents you already use</p>
          <button type="button" class="btn btn-sm mq-pause" data-marquee-pause aria-pressed="false" hidden>Pause</button>
        </div>
        <div class="marquee">
          <div class="mq-track">
            {
              [false, true].map((dup) => (
                <ul class="mq-group" aria-hidden={dup ? 'true' : undefined}>
                  {agents.map((a) => (
                    <li class="mq-item">
                      {a}
                      <svg class="mq-pair" viewBox="0 0 28 16" aria-hidden="true" focusable="false">
                        <circle class="c-blue" cx="8" cy="8" r="8" />
                        <circle class="c-green" cx="20" cy="8" r="8" />
                      </svg>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
        <div class="marquee">
          <div class="mq-track mq-rev">
            {
              [false, true].map((dup) => (
                <ul class="mq-group" aria-hidden={dup ? 'true' : undefined}>
                  {reach.map((r) => (
                    <li class="mq-item mq-sm">
                      {r}
                      <span class="dot dot-blue" aria-hidden="true"></span>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="phone-h">
    <span class="orb orb-i o-tl slow" aria-hidden="true"></span>
    <span class="orb orb-g o-br" aria-hidden="true"></span>
    <div class="container stack">
      <div class="head">
        <p class="eyebrow reveal">Android app</p>
        <h2 id="phone-h" class="reveal">Your phone is home base</h2>
        <p class="lede reveal">
          The Android app runs HQ itself as a foreground service. Chat, tasks, notes and an inbox of things
          that need your OK all live there, and so does the vault. Your laptop and servers join it, and the
          coding agents running on them report back to your phone.
        </p>
      </div>
      <ul class="phones list-plain" tabindex="0" aria-label="Screens from the Android app design preview">
        {
          phoneShots.map((p, i) => (
            <li class={`phone-shot reveal reveal-${(i % 3) + 1}`}>
              <img src={`/media/phone/${p.id}.jpg`} alt={p.alt} width="519" height="1124" loading="lazy" decoding="async" />
              <span class="small">{p.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="small phone-note">Screens from the design preview. The app already opens its native screens by default, with the web app a tap away; these show where the design is heading.</p>
      <div class="phone-facts">
        <div class="gcard">
          <h3>Works today</h3>
          <ul class="facts list-plain">
            <li>Full HQ on a phone with the <code>mobile</code> profile: daemon, chat, tasks, notes, inbox, web app, Telegram and Discord relays (chat only)</li>
            <li>A data saver for people who pay for every megabyte, and keys held in the Android Keystore</li>
            <li>Pairing a laptop or server with a QR code and six digits, and revoking a device closes its connections at once</li>
            <li>Over the link, the phone reaches your laptop's coding agents and your laptop opens the phone's web app and HQ tools</li>
            <li>Claude Code, Claude Desktop and Claude Code Remote Control reach HQ through your laptop while it is on</li>
          </ul>
        </div>
        <div class="gcard">
          <h3>Not there yet</h3>
          <ul class="facts list-plain">
            <li>Not in the Play Store yet: you install the signed app from our download link, and Play Protect may ask you to confirm once</li>
            <li>Relays are development relays today, so do not count on a production one</li>
            <li>Not yet shown that a sleeping, unplugged phone always answers in time, so keep it on a charger</li>
            <li>No agent shell on the phone: Android has no sandbox HQ can use, so that tool is refused</li>
          </ul>
        </div>
      </div>
      <div class="actions">
        <a class="btn" href={links.androidApp}>Build the Android app</a>
        <a class="btn" href={links.hqMobile}>How the mobile edition differs</a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="join-h">
    <span class="orb orb-b o-tl slow" aria-hidden="true"></span>
    <span class="orb orb-g o-br" aria-hidden="true"></span>
    <div class="container stack">
      <div class="head">
        <p class="eyebrow reveal">Joining a machine</p>
        <h2 id="join-h" class="reveal">Machines join by QR, not by VPN</h2>
        <p class="lede reveal">
          Pairing takes a minute. After that your machines reach each other directly over an encrypted
          link. They dial each other by key and punch through home routers, with a relay only as a fallback.
          You do not set up Tailscale, WireGuard or any VPN between your own machines.
        </p>
      </div>
      <ol class="rail-steps">
        <li class="rail" aria-hidden="true"><span></span></li>
        <li class="gcard reveal">
          <span class="step-dot dot-blue" aria-hidden="true"></span>
          <h3>Install HQ on the laptop or server</h3>
          <p class="body">One command on a laptop, desktop or VPS. Windows users run it inside WSL2.</p>
        </li>
        <li class="gcard reveal reveal-2">
          <span class="step-dot dot-green" aria-hidden="true"></span>
          <h3>Scan the QR code</h3>
          <p class="body">Scan the code the phone shows, or the one the laptop shows, with the other device.</p>
        </li>
        <li class="gcard reveal reveal-3">
          <span class="step-dot dot-sky" aria-hidden="true"></span>
          <h3>Type six digits</h3>
          <p class="body">The digits confirm it is really you. Then the machines are paired, and you can revoke one any time.</p>
        </li>
      </ol>
      <p class="body reveal">
        Once paired, the phone starts coding agents on the laptop and answers their questions, and agents
        call back to HQ with their own narrow credential. Your laptop opens the phone's web app and tools.
        See <a href="/install/#pair-h">how to pair</a>.
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="host-h">
    <span class="orb orb-g o-tr slow" aria-hidden="true"></span>
    <span class="orb orb-b o-bl" aria-hidden="true"></span>
    <div class="container stack">
      <div class="head">
        <p class="eyebrow reveal">Where it runs</p>
        <h2 id="host-h" class="reveal">Run it where it suits you</h2>
        <p class="lede reveal">
          HQ is one binary and a folder of markdown, so it goes wherever you have a machine.
          The phone is home base. Laptops, desktops and servers join it, or each can run HQ on its own. The vault is the same everywhere.
        </p>
      </div>
      <ul class="hosts list-plain">
        {
          hosts.map((h, i) => (
            <li class={`gcard host reveal reveal-${(i % 3) + 1}${h.preview ? ' host-featured' : ''}`}>
              <div class="host-top">
                <span class={`dot dot-${h.tone === 'indigo' ? 'blue' : h.tone}`} aria-hidden="true"></span>
                <h3>{h.name}</h3>
                {h.preview && <span class="tag tag-green">Preview</span>}
              </div>
              <p class="small host-where">{h.where}</p>
              <p class="body">{h.body}</p>
              {h.cmd && <code class="host-cmd" tabindex="0" aria-label={`Command: ${h.cmd}`}>{h.cmd}</code>}
              {h.href && <a class="host-link" href={h.href}>{h.preview ? 'See the phone app' : 'Server options'}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="fit-h">
    <span class="orb orb-b o-tr slow" aria-hidden="true"></span>
    <span class="orb orb-g o-bl" aria-hidden="true"></span>
    <div class="container fit-grid">
      <div class="stack">
        <p class="eyebrow reveal">How it fits together</p>
        <h2 id="fit-h" class="reveal">Four ways in, one agent, one vault</h2>
        <p class="lede reveal">
          The app is the main way in. Telegram, Discord and the terminal are extra doors to the same agent
          loop, and the agent reads and writes the same vault. That is the whole idea. The <a href="/architecture/">architecture page</a> goes through each part.
        </p>
        <ol class="rail-steps">
          <li class="rail" aria-hidden="true"><span></span></li>
          <li class="gcard reveal">
            <span class="step-dot dot-blue" aria-hidden="true"></span>
            <h3>Ask from anywhere</h3>
            <p class="body">The app on your phone comes first. Discord, Telegram and your terminal are optional extras, and all of them share one conversation history and one memory. Start a thread on your phone and finish it at your desk.</p>
          </li>
          <li class="gcard reveal reveal-2">
            <span class="step-dot dot-green" aria-hidden="true"></span>
            <h3>One agent does the work</h3>
            <p class="body">Sub-agents run single, parallel, race or graph. Long turns detach and report back when they finish.</p>
          </li>
          <li class="gcard reveal reveal-3">
            <span class="step-dot dot-sky" aria-hidden="true"></span>
            <h3>Everything lands in your vault</h3>
            <p class="body">Notes, memory, skills and threads are plain markdown on your disk, plus one SQLite database for search.</p>
          </li>
        </ol>
      </div>
      <div class="art glass-heavy shine zoom-in">
        <div class="art-in">
          <img
            class="parallax"
            src="/media/art/four-doors.jpg"
            alt="Flat isometric illustration: four doorways shaped like a speech bubble, a paper plane, a browser window and a terminal, all opening onto one shared room with a round table."
            width="1600"
            height="995"
            loading="lazy"
            decoding="async"
          />
          <ul class="door-chips" aria-hidden="true">
            <li class="dchip glass-heavy"><span class="dot dot-blue"></span>Discord</li>
            <li class="dchip glass-heavy"><span class="dot dot-green"></span>Telegram</li>
            <li class="dchip glass-heavy"><span class="dot dot-blue"></span>Web app</li>
            <li class="dchip glass-heavy"><span class="dot dot-green"></span>Terminal</li>
            <li class="dchip dchip-room">One room: your agent</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-top0" aria-labelledby="cap-h">
    <span class="orb orb-i o-ml slow" aria-hidden="true"></span>
    <span class="orb orb-b o-mr" aria-hidden="true"></span>
    <span class="orb orb-g o-bl slow" aria-hidden="true"></span>
    <div class="container stack">
      <div class="head">
        <p class="eyebrow reveal">What it does</p>
        <h2 id="cap-h" class="reveal">What HQ is built around</h2>
        <div class="rule rule-sm sweep" aria-hidden="true"></div>
      </div>
      <div class="bento">
        <article class="gcard span2 reveal">
          <div class="stage" aria-hidden="true">
            <span class="ring"></span>
            <span class="orbit"><i class="od1"></i><i class="od2"></i><i class="od3"></i><i class="od4"></i></span>
            <svg class="stage-pair" viewBox="0 0 56 36" aria-hidden="true" focusable="false"><circle class="c-blue" cx="18" cy="18" r="18" /><circle class="c-green" cx="38" cy="18" r="18" /></svg>
            <span class="mini glass-light m1">Discord</span>
            <span class="mini glass-light m2">Telegram</span>
            <span class="mini glass-light m3">Web app</span>
            <span class="mini glass-light m4">Terminal</span>
          </div>
          <h3>One agent on every channel</h3>
          <p class="body">Discord, Telegram, a web app that installs as a PWA, and your terminal share one conversation history and one memory. Start a thread on your phone and finish it at your desk.</p>
        </article>

        <article class="gcard reveal reveal-2">
          <div class="stage stage-bars" aria-hidden="true">
            <span class="mbar"><span class="fill-blue"></span></span>
            <span class="mbar w82"><span class="fill-green"></span></span>
            <span class="mbar w92"><span class="fill-blue"></span></span>
            <span class="mbar w60"><span class="fill-green"></span></span>
          </div>
          <h3>A vault you can read</h3>
          <p class="body">Notes, memory, skills and threads are plain markdown files on your disk, plus one SQLite database for full-text search and embeddings. Nothing is locked inside a service.</p>
        </article>

        <article class="gcard reveal">
          <div class="stage" aria-hidden="true">
            <div class="term-mini glass-light">
              <span class="tline w70"></span>
              <span class="tline w46"></span>
              <span class="tline w62"></span>
              <span class="tprompt"><span>$</span><span class="cursor"></span></span>
            </div>
            <span class="chip">Blocked</span>
          </div>
          <h3>Coding agents under supervision</h3>
          <p class="body">Start, watch, steer and resume Claude Code, Codex, OpenCode and others inside the built-in host, on this machine or a paired one. Personal agents such as Hermes and OpenClaw run there too, sandboxed and kept to research, review and monitoring. HQ tells you when one blocks. It never answers a trust prompt for you.</p>
        </article>

        <article class="gcard reveal reveal-2">
          <div class="stage" aria-hidden="true">
            <div class="cols"><span class="col">To do</span><span class="col">In progress</span><span class="col">Complete</span></div>
            <span class="mover"><i class="w80"></i><i class="w50"></i></span>
          </div>
          <h3>Tasks and sub-agents</h3>
          <p class="body">Spaces, initiatives, tasks and comments are built in, with list, board and timeline views. Sub-agents run single, parallel, race or graph. Long turns detach and report back, and /watch schedules recurring ones.</p>
        </article>

        <article class="gcard reveal reveal-3">
          <div class="stage" aria-hidden="true">
            <div class="lines"><i class="w88"></i><i class="w64 hit"></i><i class="w76"></i><i class="w52"></i></div>
            <span class="lens"></span>
          </div>
          <h3>Web search with nothing to set up</h3>
          <p class="body">web_search queries Google, DuckDuckGo, Brave, Mojeek and engines for news, science, images and code, all inside the hq process. No key, no Docker. Blocked engines are suspended and remembered, and a server on a blocked address can ask a peer HQ.</p>
        </article>

        <article class="gcard reveal">
          <div class="stage" aria-hidden="true">
            <span class="node glass-light"></span>
            <span class="label node-l">Client</span>
            <span class="link"></span>
            <span class="packet"></span>
            <svg class="node-hq" viewBox="0 0 64 44" aria-hidden="true" focusable="false"><circle class="c-blue" cx="22" cy="22" r="22" /><circle class="c-green" cx="42" cy="22" r="22" /></svg>
            <span class="label node-r">HQ</span>
          </div>
          <h3>An MCP server for your tools</h3>
          <p class="body">Two tools, hq_discover and hq_call, open the whole registry to Claude Code, Cursor, VS Code, Copilot and other MCP clients. Remote MCP servers can be bridged in the other direction.</p>
        </article>

        <article class="gcard gcard-indigo span2 reveal reveal-2">
          <div class="stage stage-safe" aria-hidden="true">
            <span class="scan"></span>
            <svg class="shield" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z M9 12l2 2 4-4"></path></svg>
            <span class="safe-tags">
              <span class="tag tag-green">Bash sandbox</span>
              <span class="tag tag-blue">Env allowlist</span>
              <span class="tag tag-light">Signed releases</span>
            </span>
          </div>
          <h3>Safe by default</h3>
          <p class="body">Agent shell commands run in a sandbox with an environment allowlist. Untrusted content taints a session and cuts off secrets and outbound network. Servers update from signed releases and roll back on a failed health check.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="see-h">
    <span class="see-glow" aria-hidden="true"></span>
    <div class="container stack" data-tabs>
      <div class="see-head">
        <div class="head">
          <p class="eyebrow reveal">See it</p>
          <h2 id="see-h" class="reveal">The web app, on your own server</h2>
        </div>
        <div class="seg glass-heavy" role="group" aria-label="Choose a screen" data-tablist hidden>
          <span class="seg-ind" aria-hidden="true"></span>
          {
