<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/needs_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/needs_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEEDS YOU"
        android:textColor="#D0D2D3" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06"/>
    <TextView android:id="@+id/needs_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
        android:textColor="#FFFFFF" android:textSize="44sp" android:textStyle="bold"/>
    <TextView android:id="@+id/needs_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to review"
        android:textColor="#D0D2D3" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/needs_footer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
        android:textColor="#D0D2D3" android:textSize="12sp"/>
</LinearLayout>
