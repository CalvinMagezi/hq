{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HQ",
  "version": "0.9.1",
  "identifier": "dev.hq-oss.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "bun run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": [
        "control"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "HQ on your Mac",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
