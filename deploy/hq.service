[Unit]
Description=Agent HQ
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hq
Group=hq
ExecStart=/usr/local/bin/hq start all
Environment=HQ_VAULT_PATH=/opt/hq/.vault
Environment=HQ_CONFIG_PATH=/opt/hq/config.yaml
# Belt-and-suspenders for probe_can_build_self(): the compiled-in checkout
# path is baked in at build time from wherever `cargo build` ran, so this
# only matters if that path ever goes stale. See `probe_can_build_self` in hq-core's `machine` module.
Environment=AGENT_HQ_SRC=/opt/hq/src
Environment=RUST_LOG=info
# Optional provider and gws credentials. The leading `-` lets a fresh VPS start without them.
# Every env file lives in /etc/hq (root-owned; files root:root, mode 0600), never in /opt/hq:
# the hq user owns /opt/hq, so HQ's own agents could create a file there for the next restart
# to load. deploy/install.sh moves old /opt/hq/*.env files here.
EnvironmentFile=-/etc/hq/openrouter.env
EnvironmentFile=-/etc/hq/gws.env
# Optional: GH_TOKEN=... authenticates `gh` and git over HTTPS for HQ and every agent it starts.
# See deploy/README.md, "GitHub access".
EnvironmentFile=-/etc/hq/gh.env
WorkingDirectory=/opt/hq
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hq
PrivateTmp=true

[Install]
WantedBy=multi-user.target
