[Unit]
Description=Apply the HQ private network peers to %i
After=wg-quick@%i.service
# Not Wants=: a change to the HQ user's file must never start a tunnel that was stopped on purpose.
Requisite=wg-quick@%i.service
ConditionPathExists=/var/lib/hq-net/%i.conf
# A burst of changes must not trip the start limit: that would leave the path unit dead and every
# later revocation unapplied.
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=30s
# HQ_NET_SUBNET, HQ_NET_HUB and HQ_NET_OWNER_UID come from a root-owned file, never from the
# input the applier is about to read.
EnvironmentFile=/etc/hq-net/%i.env
ExecStart=/opt/hq-net/hq-net-apply --interface %i --subnet ${HQ_NET_SUBNET} --hub ${HQ_NET_HUB} --owner-uid ${HQ_NET_OWNER_UID} --input /var/lib/hq-net/%i.conf

NoNewPrivileges=yes
# CAP_NET_ADMIN lets wg configure the interface; CAP_DAC_READ_SEARCH lets root read the one input
# file, which is private to the HQ user.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
# The hub's private key is in memory while this runs.
LimitCORE=0

[Install]
# Start with the tunnel, so peers are applied after every boot and every restart of wg-quick.
WantedBy=wg-quick@%i.service
