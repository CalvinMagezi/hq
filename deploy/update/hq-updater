#!/bin/sh
# Installed as /usr/local/lib/hq/hq-updater and run by hq-update.service as
# root. All logic lives in `hq update` (signature checks, swaps, rollback);
# this wrapper only pins the binary path so the unit never resolves it via
# an environment the caller controls.
set -eu
umask 022
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
HQ_BIN=/usr/local/bin/hq
if [ ! -x "$HQ_BIN" ]; then
    echo "hq-updater: $HQ_BIN is missing; run deploy/install.sh" >&2
    exit 1
fi
# This runs as root: never run a link (`install-hq.sh --link` points this path at a file in a
# user's home) or a file anyone but root can change.
if [ -L "$HQ_BIN" ] || [ ! -f "$HQ_BIN" ] \
    || [ "$(stat -c %u "$HQ_BIN")" != 0 ] || [ "$(stat -c %u "${HQ_BIN%/*}")" != 0 ] \
    || [ -n "$(find "$HQ_BIN" "${HQ_BIN%/*}" -maxdepth 0 -perm /022 2>/dev/null)" ]; then
    echo "hq-updater: refusing to run $HQ_BIN as root: it must be a plain file owned by root, in a folder owned by root, and writable by nobody else. See docs/UPDATE_SYSTEM.md" >&2
    exit 1
fi
exec "$HQ_BIN" update --apply "$@"
