# The public forwarder (docs/EDGE.md). Install on a public machine you control:
#   sudo useradd --system --create-home --home-dir /var/lib/hq-edge --shell /usr/sbin/nologin hq-edge
#   sudo install -m 0644 deploy/edge/hq-edge.service /etc/systemd/system/hq-edge.service
#   sudo install -d -o hq-edge -m 0700 /var/lib/hq-edge/.hq
#   (write /var/lib/hq-edge/.hq/config.yaml, see docs/EDGE.md), then:
#   sudo systemctl enable --now hq-edge
[Unit]
Description=HQ edge, a blind TLS forwarder to paired devices
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hq-edge
Group=hq-edge
# The edge reads only the edge: section of this file, from this user's home.
Environment=HOME=/var/lib/hq-edge
Environment=HQ_CONFIG_PATH=/var/lib/hq-edge/.hq/config.yaml
ExecStart=/usr/local/bin/hq edge run
Restart=always
RestartSec=5
# Open file descriptors: one per forwarded connection plus one per pending ClientHello.
LimitNOFILE=65536

# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
# The edge key, the device list and the relay's certificate cache live here.
ReadWritePaths=/var/lib/hq-edge
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# iroh watches the machine's network interfaces over netlink; without AF_NETLINK it cannot tell
# when the address changes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
